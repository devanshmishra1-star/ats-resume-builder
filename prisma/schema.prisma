generator client {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  featuredImage   String?
  content         String
  category        String
  tags            String[]
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  faqSection      Json?
  author          String?
  status          String    @default("DRAFT")
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  readTime        String?
}

model Template {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  university       String?
  degree           String?
  category         String
  shortDescription String?
  thumbnailImage   String?
  previewImages    String[]
  badge            String?
  isFeatured       Boolean   @default(false)
  displayOrder     Int       @default(0)
  status           String    @default("DRAFT")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  filename  String
  format    String   @default("unknown")
  size      Int      @default(0)
  width     Int?
  height    Int?
  altText   String?
  createdAt DateTime @default(now())
}

model Settings {
  id              String   @id @default(cuid())
  contactEmail    String?
  phoneNumber     String?
  socialLinks     Json?
  footerLinks     Json?
  androidAppLink  String?
  googleAnalytics String?
  searchConsole   String?
  adsenseCode     String?
  gtmId           String?
  updatedAt       DateTime @updatedAt
}

model InboxMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isSubscribed Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String?
  name         String?
  provider     String        @default("email")
  isPremium    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  coverLetters CoverLetter[]
  resumes      SavedResume[]
}

model SavedResume {
  id        String          @id @default(cuid())
  userId    String
  title     String
  data      Json
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  versions  ResumeVersion[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeVersion {
  id            String      @id @default(cuid())
  resumeId      String
  data          Json
  versionNumber Int         @default(1)
  createdAt     DateTime    @default(now())
  resume        SavedResume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model CoverLetter {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PremiumTemplate {
  id        String   @id @default(cuid())
  name      String
  price     Float    @default(0.0)
  createdAt DateTime @default(now())
}

model DigitalPortfolio {
  id           String   @id @default(cuid())
  slug         String   @unique
  editToken    String
  data         Json
  isPublished  Boolean  @default(false)
  isSearchable Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
